{
  "name": "kotlin-parser",
  "description": "Kotlin parser powered by WebAssembly, with syntax trees, incremental parsing and semantic token classification.",
  "version": "0.0.8",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    "./wasm": {
      "types": "./dist/kotlin-parser.d.mts",
      "import": "./dist/kotlin-parser.mjs"
    },
    "./editor": {
      "types": "./dist/editor.d.ts",
      "import": "./dist/editor.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "node scripts/generate-lexer.ts",
    "generate:check": "node scripts/generate-lexer.ts --check",
    "build": "node scripts/build.ts",
    "test:bundle": "node scripts/test-bundle.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lisonge/kotlin-syntax.git",
    "directory": "kotlin-parser"
  },
  "homepage": "https://github.com/lisonge/kotlin-syntax#readme",
  "bugs": {
    "url": "https://github.com/lisonge/kotlin-syntax/issues"
  }
}
