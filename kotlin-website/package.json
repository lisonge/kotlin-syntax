{
  "name": "kotlin-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare.ts && vite --host 127.0.0.1",
    "build": "node scripts/prepare.ts && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/theme.ts test/worker.ts"
  },
  "dependencies": {
    "kotlin-parser": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@codemirror/commands": "catalog:"
  }
}
