{
  "name": "kotlin-vscode",
  "displayName": "Kotlin Syntax",
  "description": "Kotlin syntax highlighting, navigation and ktfmt-compatible formatting. No JVM runtime required.",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#191c22",
    "theme": "dark"
  },
  "pricing": "Free",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.117.0"
  },
  "scripts": {
    "vscode:prepublish": "node scripts/prepublish.ts",
    "build": "node scripts/build.ts",
    "test:host": "node scripts/test-host.ts",
    "test": "node --test test/bundle.ts test/worker.ts test/name-filter.ts test/workspace-files.ts test/format.ts"
  },
  "contributes": {
    "languages": [
      {
        "id": "kotlin",
        "aliases": [
          "Kotlin"
        ],
        "extensions": [
          ".kt",
          ".kts"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "[kotlin]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "commands": [
      {
        "command": "kotlinSyntax.showLogs",
        "title": "Kotlin Syntax: Show Logs"
      },
      {
        "command": "kotlinSyntax.restartParser",
        "title": "Kotlin Syntax: Restart Parser"
      }
    ],
    "configuration": {
      "title": "Kotlin Syntax",
      "properties": {
        "kotlinSyntax.format.maxWidth": {
          "minimum": 1,
          "maximum": 999,
          "type": "integer",
          "scope": "resource",
          "default": 100,
          "description": "Preferred maximum line width for Kotlin formatting."
        },
        "kotlinSyntax.format.style": {
          "enum": [
            "KOTLINLANG",
            "GOOGLE",
            "META"
          ],
          "type": "string",
          "default": "KOTLINLANG",
          "scope": "resource",
          "description": "ktfmt formatting style (including indentation and trailing comma policy)."
        }
      }
    }
  },
  "publisher": "lisonge",
  "main": "./dist/extension.js",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "kotlin",
    "kts",
    "syntax",
    "highlighting",
    "wasm"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lisonge/kotlin-syntax.git",
    "directory": "kotlin-vscode"
  },
  "homepage": "https://github.com/lisonge/kotlin-syntax#readme",
  "bugs": {
    "url": "https://github.com/lisonge/kotlin-syntax/issues"
  }
}
