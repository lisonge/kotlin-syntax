{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "vscode"
    ],
    "rootDirs": [
      "src",
      "dist"
    ]
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "dist",
    "build",
    "node_modules"
  ]
}
